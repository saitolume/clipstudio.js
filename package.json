{
  "name": "clipstudio",
  "description": "A JavaScript library for using CLIP STUDIO .clip file on browsers and Node.js",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saitoeku3/clipstudio.js"
  },
  "files": [
    "dist"
  ],
  "author": "Tadao Iseki <saitoeku3@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "npx http-server . -p 0 --cors",
    "format": "biome format --write src/",
    "lint": "biome lint src/",
    "check": "biome check src/",
    "ci": "biome ci src/",
    "test": "tsx --test test/clipstudio.test.ts test/sqlite.test.ts test/utils.test.ts",
    "test:e2e": "playwright test",
    "prepublishOnly": "pnpm run build",
    "release": "npm version patch && git push origin --tags"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.53.2",
    "@types/sql.js": "^1.4.9",
    "playwright": "^1.53.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "engines": {
    "node": ">=20.19.3"
  }
}
